MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-small-2603
LLM_PROVIDER=mistral

# Optional: Only needed for Hinglish transcription via Sarvam AI
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_STT_MODEL=saaras:v3

# Whisper model size: tiny, base, small (default), medium, large
# Use 'base' on low-RAM machines, 'small' on HuggingFace Spaces (16 GB RAM)
WHISPER_MODEL=small
